{
  "name": "@stackline/esprima",
  "version": "1.0.3",
  "description": "Compatibility-first maintained Esprima 4 parser with a dependency-free runtime, reproducible build, and first-party types",
  "type": "commonjs",
  "main": "./dist/esprima.js",
  "types": "./index.d.ts",
  "browser": "./dist/esprima.js",
  "unpkg": "./dist/esprima.js",
  "jsdelivr": "./dist/esprima.js",
  "sideEffects": false,
  "bin": {
    "esparse": "./bin/esparse.js",
    "esvalidate": "./bin/esvalidate.js"
  },
  "files": [
    "bin",
    "dist/esprima.js",
    "index.d.ts",
    "CHANGELOG.md",
    "COMPATIBILITY_CONTRACT.md",
    "LICENSE",
    "MIGRATION.md",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "node": ">=8"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "generate-fixtures": "node tools/generate-fixtures.js",
    "test:upstream": "npm run generate-fixtures && node test/unit-tests.js && node scripts/run-api-tests.cjs && node test/regression-tests.js && node test/hostile-environment-tests.js && node test/verify-line-ending.js",
    "test:differential": "node test/stackline/differential.cjs",
    "test:security": "node --test test/stackline/security.test.cjs test/stackline/stress.test.cjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:bins": "node test/stackline/bin-smoke.cjs",
    "test:types": "node node_modules/typescript-3-9/bin/tsc -p test/stackline/types/tsconfig.legacy.json && node node_modules/typescript/bin/tsc -p test/stackline/types/tsconfig.current.json",
    "test:runtime": "node test/stackline/runtime.cjs",
    "test": "npm run test:upstream && npm run test:differential && npm run test:security && npm run test:browser && npm run test:bins && npm run test:types && npm run test:runtime",
    "test:smoke": "node scripts/smoke-install.mjs",
    "docs:build": "npm run build && node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "check:package": "publint && attw --pack .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "pack:check": "npm pack --dry-run",
    "audit:dependencies": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit --audit-level=low",
    "verify": "npm run clean && npm run build && npm test && npm run test:smoke && npm run check:package && npm run check:licenses && npm run pack:check && npm run docs:build && npm run docs:check && npm run audit:dependencies && npm run audit:all",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-esprima.git"
  },
  "homepage": "https://alexandro.net/docs/vanilla/esprima/",
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-esprima/issues"
  },
  "keywords": [
    "stackline",
    "npm-package",
    "esprima",
    "parser",
    "typescript",
    "nodejs",
    "ast",
    "ecmascript",
    "javascript",
    "syntax",
    "jsx",
    "estree"
  ],
  "author": "Stackline Maintainers",
  "contributors": [
    "Ariya Hidayat",
    "JS Foundation and other Esprima contributors"
  ],
  "license": "BSD-2-Clause",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "esbuild": "0.28.2",
    "esprima-baseline": "npm:esprima@4.0.1",
    "publint": "0.3.24",
    "typescript": "5.9.3",
    "typescript-3-9": "npm:typescript@3.9.10"
  }
}
